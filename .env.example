# ==============================================================================
# Envocado Project - Environment Variables Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_NAME=Envocado Demo Store

# Database Configuration (URL format required)
DATABASE_URL=postgres://demo_user:demopass123@localhost:5432/envocado_demo

# Security & Secrets (Must be at least 16 characters; redacted from logs)
API_SECRET_KEY=super_secure_secret_token_12345

# Application Limits & Feature Flags
RATE_LIMIT_MAX=100
ENABLE_ANALYTICS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=admin@envocado.dev
